# /srv/optics/.env.production  (chmod 600, owner optics) — read by systemd (EnvironmentFile).
# Never commit the real file. deploy/setup-server.sh creates it from this example on the first
# run and fills in SECRET_KEY, the domain, the database URL and ADMIN_URL automatically.
# Lines marked  <-- YOU  must be filled in by you (R2 keys, optionally Sentry).
# No quotes around values; no spaces around "=".

# --- Django -------------------------------------------------------------------------
# Generated automatically: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=optics-api.tera-software1.com
CSRF_TRUSTED_ORIGINS=https://optics-api.tera-software1.com
# Own database and role; the pharmacy database is not touched. Generated automatically when
# setup-server.sh creates the local database (DB_MODE=local).
DATABASE_URL=postgres://optics:CHANGE_ME@127.0.0.1:5432/optics
CONN_MAX_AGE=60
STATIC_ROOT=/srv/optics/static
MEDIA_ROOT=/srv/optics/media
CACHE_DIR=/srv/optics/cache
# Less guessable admin path (keep the trailing slash). Generated automatically.
ADMIN_URL=tera-admin-CHANGE-ME/
# Shown by /api/v1/health/.
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- gunicorn (deploy/gunicorn.conf.py) ---------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Security / proxies -------------------------------------------------------------
SECURE_SSL_REDIRECT=True
# 1 year; lower (e.g. 3600) for the first deploy if unsure, then raise.
SECURE_HSTS_SECONDS=31536000
# nginx on loopback (+ Cloudflare edges when the domain is proxied by Cloudflare;
# config/settings/proxies.py — refresh the ranges). False when NOT behind Cloudflare.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUST_CLOUDFLARE=True
AUTH_THROTTLE_RATE=30/min
UPDATE_THROTTLE_RATE=120/min

# --- Error alerts (optional) --------------------------------------------------------
# sentry.io → new Django project → copy the DSN. Empty = off. Only stack traces are sent,
# never request bodies or patient data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Backups to Cloudflare R2 (deploy/backup/optics-backup.sh) ----------------------
# (systemd does not allow comments after a value: keep comments on their own lines.)
# <-- YOU: Cloudflare dashboard → R2 → Account ID (right-hand panel)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=optics-backups
# <-- YOU: R2 → Manage API tokens → Object Read & Write on the bucket
AWS_ACCESS_KEY_ID=r2-access-key-id
AWS_SECRET_ACCESS_KEY=r2-secret-access-key
BACKUP_DIR=/srv/optics/backups
BACKUP_KEEP_DAYS=7
