# /srv/optics/.env.production  (chmod 600, owner optics) — read by systemd (EnvironmentFile).
# Never commit the real file.

# --- Django -------------------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=optics-api.tera-software1.com
CSRF_TRUSTED_ORIGINS=https://optics-api.tera-software1.com
# Own database and role; the pharmacy database is not touched.
DATABASE_URL=postgres://optics:CHANGE_ME@127.0.0.1:5432/optics
CONN_MAX_AGE=60
STATIC_ROOT=/srv/optics/static
MEDIA_ROOT=/srv/optics/media
# Less guessable admin path (keep the trailing slash).
ADMIN_URL=tera-admin-CHANGE-ME/
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Security / proxies -------------------------------------------------------------
SECURE_SSL_REDIRECT=True
# 1 year; lower (e.g. 3600) for the first deploy if unsure, then raise.
SECURE_HSTS_SECONDS=31536000
# nginx on loopback + Cloudflare edges (config/settings/proxies.py; refresh the ranges).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUST_CLOUDFLARE=True
AUTH_THROTTLE_RATE=30/min
UPDATE_THROTTLE_RATE=120/min

# --- Backups to Cloudflare R2 (deploy/backup/optics-backup.sh) ----------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=optics-backups
AWS_ACCESS_KEY_ID=r2-access-key-id
AWS_SECRET_ACCESS_KEY=r2-secret-access-key
BACKUP_DIR=/srv/optics/backups
BACKUP_KEEP_DAYS=7
