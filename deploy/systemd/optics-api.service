# /etc/systemd/system/optics-api.service — gunicorn for the Optics API.
# Separate user, folder, socket and service name from the pharmacy backend.
# Installed by deploy/setup-server.sh; settings in deploy/gunicorn.conf.py.
[Unit]
Description=Optics Lab API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=optics
Group=www-data
WorkingDirectory=/srv/optics/app/backend
EnvironmentFile=/srv/optics/.env.production
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
RuntimeDirectory=optics
RuntimeDirectoryMode=0750
ExecStart=/srv/optics/venv/bin/gunicorn config.wsgi:application \
    --config /srv/optics/app/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/optics/media /srv/optics/cache

[Install]
WantedBy=multi-user.target
