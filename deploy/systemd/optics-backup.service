# /etc/systemd/system/optics-backup.service — one PostgreSQL + media backup to Cloudflare R2.
[Unit]
Description=Optics Lab backup (PostgreSQL + media → R2)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=optics
EnvironmentFile=/srv/optics/.env.production
# awscli lives in its own venv (deploy/setup-server.sh), separate from the app packages.
Environment=PATH=/srv/optics/tools-venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/optics/app/deploy/backup/optics-backup.sh
