# Line endings: the repository stores LF; working copies use LF too (overrides core.autocrlf),
# so Dart, Python and config files are byte-identical on Windows, Linux and macOS.
* text=auto eol=lf

# Source and config (explicit, in case auto-detection guesses wrong).
*.dart      text eol=lf diff=dart
*.py        text eol=lf diff=python
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf diff=markdown
*.txt       text eol=lf
*.sh        text eol=lf
*.cmake     text eol=lf
*.cc        text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.swift     text eol=lf
*.plist     text eol=lf
*.xcconfig  text eol=lf
*.pbxproj   text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.lock      text eol=lf

# Windows-only scripts keep CRLF in the working copy (stored as LF).
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.iss       text eol=crlf

# Binary files: never touch line endings, no text diffs.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.exe       binary
*.dll       binary
*.zip       binary
*.sqlite3   binary
*.db        binary
