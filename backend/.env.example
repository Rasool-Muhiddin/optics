# Copy to .env.local for development (never commit .env.local).
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite is fine locally; production uses Postgres, e.g.
# DATABASE_URL=postgres://optics:password@127.0.0.1:5432/optics
DATABASE_URL=sqlite:///db.sqlite3
APP_VERSION=0.1.0
# Throttle for public desktop activate/login (per IP).
AUTH_THROTTLE_RATE=30/min
